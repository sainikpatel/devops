pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    triggers {
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/YOUR_USERNAME/JavaPipelineProject.git'
            }
        }

        stage('Compile') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Package') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }
    }

    post {
        success {
            echo 'Java Build Successful!'
            archiveArtifacts artifacts: 'target/*.jar'
        }
        always {
            junit 'target/surefire-reports/*.xml'
        }
    }
}
